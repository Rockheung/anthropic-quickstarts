# MCP Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8000
LOG_LEVEL=INFO

# Performance Configuration
MAX_SCREENSHOT_SIZE=5242880  # 5MB max screenshot size
RATE_LIMIT_REQUESTS=100      # Max requests per window
RATE_LIMIT_WINDOW=60         # Rate limit window in seconds

# Display Configuration
DISPLAY=:99
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

# VNC Configuration (for debugging - set ENABLE_VNC=true to activate)
ENABLE_VNC=false
VNC_PASSWORD=
VNC_PORT=5900

# Security Configuration
PYTHONHASHSEED=random
PYTHONDONTWRITEBYTECODE=1

# Development/Production Mode
NODE_ENV=production