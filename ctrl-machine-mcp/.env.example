# HID Input MCP Server Configuration

# VNC Password (optional - leave empty for no password)
VNC_PASSWORD=mypass123

# Browser Configuration
START_BROWSER=false
CHROME_URL=https://www.google.com

# Logging
MCP_LOG_LEVEL=INFO

# Display Configuration
DISPLAY=:99

# Ports (if you need to change default ports)
# VNC_PORT=5900
# MCP_PORT=8080