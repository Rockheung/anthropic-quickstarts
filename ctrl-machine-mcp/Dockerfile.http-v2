# MCP HTTP Server Docker Image v2 - Container-isolated display control
FROM --platform=linux/amd64 python:3.12-slim

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99
ENV VNC_PASSWORD=""
ENV SCREENSHOT_MCP_PORT=8080
ENV HID_MCP_PORT=8081

# Install system packages
RUN apt-get update && apt-get install -y \
    # X11 and display dependencies
    xvfb \
    x11vnc \
    fluxbox \
    xterm \
    x11-utils \
    # GUI automation dependencies  
    scrot \
    xdotool \
    xclip \
    # System utilities
    wget \
    curl \
    gnupg \
    lsb-release \
    sudo \
    git \
    nano \
    procps \
    # Python GUI libraries
    python3-tk \
    python3-dev \
    python3-pil \
    python3-pil.imagetk \
    # Build dependencies
    gcc \
    libc6-dev \
    linux-libc-dev \
    # X11 development libraries for PyAutoGUI
    libx11-dev \
    libxext-dev \
    libxrender-dev \
    libxinerama-dev \
    libxi-dev \
    libxrandr-dev \
    libxcursor-dev \
    libxtst-dev \
    libxkbfile-dev \
    # Clean up
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Chrome browser
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Korean fonts
RUN wget -P /tmp https://launchpad.net/ubuntu/+archive/primary/+files/fonts-nanum_20200506-1_all.deb \
    && wget -P /tmp https://launchpad.net/ubuntu/+archive/primary/+files/fonts-nanum-coding_2.5-1_all.deb \
    && dpkg -i /tmp/fonts-nanum*.deb || true \
    && apt-get update && apt-get install -f -y \
    && rm /tmp/fonts-nanum*.deb \
    && fc-cache -fv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash mcpuser && \
    echo 'mcpuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

WORKDIR /app

# Install Python packages
RUN pip3 install --no-cache-dir \
    aiohttp==3.9.1 \
    mcp>=0.1.0 \
    pillow>=10.0.0 \
    pyautogui==0.9.54 \
    mss>=9.0.1 \
    numpy>=1.24.0 \
    python-xlib>=0.33 \
    pyscreeze>=0.1.30

# Copy MCP server files
COPY screenshot_mcp_http_v2.py /app/screenshot_mcp_http.py
COPY hid_input_mcp_http_v2.py /app/hid_input_mcp_http.py

# Create screenshots directory
RUN mkdir -p /app/screenshots && chown -R mcpuser:mcpuser /app

# Create startup script with proper cleanup
RUN cat > /app/start.sh << 'EOF'
#!/bin/bash
set -e

# Function to cleanup on exit
cleanup() {
    echo "Cleaning up processes..."
    if [ -n "$XVFB_PID" ]; then kill $XVFB_PID 2>/dev/null || true; fi
    if [ -n "$FLUXBOX_PID" ]; then kill $FLUXBOX_PID 2>/dev/null || true; fi
    if [ -n "$VNC_PID" ]; then kill $VNC_PID 2>/dev/null || true; fi
    if [ -n "$SCREENSHOT_PID" ]; then kill $SCREENSHOT_PID 2>/dev/null || true; fi
    if [ -n "$HID_PID" ]; then kill $HID_PID 2>/dev/null || true; fi
    rm -f /tmp/.X99-lock /tmp/.X11-unix/X99
    exit
}

# Set trap for cleanup
trap cleanup EXIT INT TERM

# Clean up any existing X server locks
echo "Cleaning up old X server locks..."
rm -f /tmp/.X99-lock /tmp/.X11-unix/X99

echo "Starting X virtual framebuffer on display :99..."
Xvfb :99 -screen 0 1920x1080x24 -ac +extension GLX +render -noreset &
XVFB_PID=$!
sleep 3

# Verify Xvfb started
if ! kill -0 $XVFB_PID 2>/dev/null; then
    echo "ERROR: Xvfb failed to start"
    exit 1
fi

echo "Starting window manager..."
DISPLAY=:99 fluxbox &
FLUXBOX_PID=$!
sleep 2

echo "Configuring VNC server..."
if [ -n "$VNC_PASSWORD" ]; then
    echo "Setting VNC password..."
    mkdir -p /home/mcpuser/.vnc
    x11vnc -storepasswd "$VNC_PASSWORD" /home/mcpuser/.vnc/passwd
    x11vnc -display :99 -rfbauth /home/mcpuser/.vnc/passwd -listen 0.0.0.0 -forever -shared -noshm &
else
    echo "Starting VNC without password..."
    x11vnc -display :99 -nopw -listen 0.0.0.0 -forever -shared -noshm &
fi
VNC_PID=$!
sleep 2

echo "Starting Screenshot MCP HTTP server on port $SCREENSHOT_MCP_PORT..."
DISPLAY=:99 SCREENSHOT_MCP_PORT=$SCREENSHOT_MCP_PORT python3 /app/screenshot_mcp_http.py &
SCREENSHOT_PID=$!
sleep 2

echo "Starting HID Input MCP HTTP server on port $HID_MCP_PORT..."
DISPLAY=:99 HID_MCP_PORT=$HID_MCP_PORT python3 /app/hid_input_mcp_http.py &
HID_PID=$!
sleep 2

echo "================================"
echo "All services started successfully:"
echo "  Display: :99 (1920x1080)"
echo "  VNC Port: 5900"
echo "  Screenshot MCP Port: $SCREENSHOT_MCP_PORT"
echo "  HID Input MCP Port: $HID_MCP_PORT"
echo "  Process PIDs:"
echo "    Xvfb: $XVFB_PID"
echo "    Fluxbox: $FLUXBOX_PID"
echo "    VNC: $VNC_PID"
echo "    Screenshot MCP: $SCREENSHOT_PID"
echo "    HID MCP: $HID_PID"
echo "================================"

# Monitor processes
while true; do
    # Check if critical processes are still running
    if ! kill -0 $XVFB_PID 2>/dev/null; then
        echo "ERROR: Xvfb died unexpectedly"
        exit 1
    fi
    if ! kill -0 $SCREENSHOT_PID 2>/dev/null; then
        echo "ERROR: Screenshot MCP server died unexpectedly"
        exit 1
    fi
    if ! kill -0 $HID_PID 2>/dev/null; then
        echo "ERROR: HID MCP server died unexpectedly"
        exit 1
    fi
    sleep 10
done
EOF
RUN chmod +x /app/start.sh

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${SCREENSHOT_MCP_PORT}/health && \
        curl -f http://localhost:${HID_MCP_PORT}/health || exit 1

# Switch to non-root user for running services
USER mcpuser

# Expose ports
EXPOSE 5900 8080 8081

# Run startup script
ENTRYPOINT ["/app/start.sh"]