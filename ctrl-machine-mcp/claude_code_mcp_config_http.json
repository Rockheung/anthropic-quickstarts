{
  "mcpServers": {
    "screenshot-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-axios",
        "http://localhost:8080"
      ],
      "env": {
        "MCP_LOG_LEVEL": "INFO"
      }
    },
    "hid-input-mcp": {
      "command": "npx", 
      "args": [
        "-y",
        "@modelcontextprotocol/server-axios",
        "http://localhost:8081"
      ],
      "env": {
        "MCP_LOG_LEVEL": "INFO"
      }
    }
  }
}